# Beuk app image + the M5 job tools that run INSIDE the app container:
# a JRE (for EPUBCheck), Ghostscript, and the CMYK press profile the
# PDF/X job embeds.
# deploy/install.sh builds this as an overlay ON TOP of the stock app image
# (which deliberately stays slim). EPUBCheck itself is not baked in here —
# install.sh downloads the release into ../tools-bin/ and this file copies
# it to /opt/epubcheck/ (epubcheck.jar + its lib/ alongside).
#
# Headless Chromium is deliberately NOT installed here any more: it runs
# user-supplied print-html, so it lives in its own locked-down "renderer"
# service (deploy/renderer/, wired in deploy/docker-compose.tools.yml),
# never in the container that holds the database URL, the Stripe keys,
# and the export/backup volumes.
ARG BASE_IMAGE=beuk-app:latest
FROM ${BASE_IMAGE}
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      default-jre-headless ghostscript ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
# The CMYK press profile tools/PDFX_def.ps embeds (its /BeukICCPath line):
# IDEAlliance's SWOP2006_Coated3v2.icc (characterisation CGATS TR 003)
# from the ICC Profile Registry, pinned by sha256 — any other bytes fail
# the build. Why this profile, and its licence ("may be used, embedded,
# exchanged, and shared without restriction"; not altered or sold):
# tools/PDFX_def.ps and tools/icc/LICENSE-SWOP2006_Coated3v2.txt.
# https://registry.color.org/profile-registry/SWOP2006_Coated3v2
# (Debian's icc-profiles-free has no CMYK press profile — FOGRA data only
# as .ti3 — and non-free icc-profiles 2.1-2 carries a different, older
# SWOP2006_Coated3v2.icc build whose ICC profile ID does not match the
# registry's, so the registry file is used.)
ARG ICC_URL=https://registry.color.org/profile-registry/profiles/SWOP2006_Coated3v2.icc
ARG ICC_SHA256=27dc90dbeb399b76c0f91a6b387fe30c38939f034d2500712f3c43094be15e3b
RUN mkdir -p /usr/share/color/icc/beuk \
 && curl -fsSL --retry 3 -o /usr/share/color/icc/beuk/SWOP2006_Coated3v2.icc "$ICC_URL" \
 && echo "$ICC_SHA256  /usr/share/color/icc/beuk/SWOP2006_Coated3v2.icc" | sha256sum -c - \
 && chmod 0644 /usr/share/color/icc/beuk/SWOP2006_Coated3v2.icc
COPY tools/icc/LICENSE-SWOP2006_Coated3v2.txt /usr/share/color/icc/beuk/
# The pdfx job's colour-conversion directory (PDFX_ICC_DIR, passed to
# Ghostscript as -sICCProfilesDir). Ghostscript's pdfwrite converts RGB
# into the default_cmyk.icc it finds there and ignores
# -sOutputICCProfile (measured on 10.00.0; src/jobs/tools.ts
# pdfxIccDirArgs has the numbers), so this directory holds Ghostscript's
# own profiles with default_cmyk.icc replaced by a byte-identical copy
# of the pinned SWOP profile — the same file the OutputIntent embeds.
# The copy is checked against the pinned sha256 again, and the profile
# is not altered (its licence forbids that; copying under another file
# name is not an alteration).
RUN set -e; gsicc="$(ls -d /usr/share/ghostscript/*/iccprofiles | head -n1)"; \
    test -f "$gsicc/default_rgb.icc"; \
    mkdir -p /usr/share/color/icc/beuk/gs; \
    cp "$gsicc"/*.icc /usr/share/color/icc/beuk/gs/; \
    cp /usr/share/color/icc/beuk/SWOP2006_Coated3v2.icc /usr/share/color/icc/beuk/gs/default_cmyk.icc; \
    echo "$ICC_SHA256  /usr/share/color/icc/beuk/gs/default_cmyk.icc" | sha256sum -c -; \
    chmod 0644 /usr/share/color/icc/beuk/gs/*.icc
COPY tools-bin/ /opt/epubcheck/
USER node
