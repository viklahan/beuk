# Beuk — Caddy reverse proxy.
# DOMAIN comes from .env: "localhost" for local dev (internal CA, https://localhost),
# "beuk.studio" in production (automatic Let's Encrypt TLS).

# ==== BEUK:lanhttps ==== start-local.ps1 also serves https on this
# machine's network addresses (https://192.168.x.x:8443), with
# certificates from Caddy's own local CA (Caddy issues IP addresses from
# its internal issuer: https://caddyserver.com/docs/automatic-https).
# A browser opening an IP sends no SNI (RFC 6066 §3: Literal IPv4 and
# IPv6 addresses are not permitted in "HostName"), and inside Docker the
# connection's own address is the container's, not the LAN one, so
# DEFAULT_SNI names the certificate to answer with. Unset (production)
# it names a host with no certificate, which changes nothing.
{
	default_sni {$DEFAULT_SNI:beuk.invalid}
}

# WWW_DOMAIN (optional, e.g. www.beuk.studio): served on the same site
# and permanently redirected to DOMAIN, so the studio, its cookies and
# its local saves live on ONE origin. Unset/empty → expands to nothing
# and only DOMAIN is served ("{$VAR}" is substituted before parsing and
# may expand to nothing: https://caddyserver.com/docs/caddyfile/concepts).
#
# LAN_SITES (local only, BEUK:lanhttps): start-local.ps1's extra https
# addresses (https://localhost:8443 https://192.168.x.x:8443 …). Its own
# variable, not part of DOMAIN: the redir below names {$DOMAIN} as ONE
# token. Unset → expands to nothing, as WWW_DOMAIN does.
{$DOMAIN} {$WWW_DOMAIN} {$LAN_SITES} {
	encode gzip

	# "www.invalid" keeps the matcher non-empty when WWW_DOMAIN is empty
	# (.invalid never resolves: RFC 2606 §2).
	@www host {$WWW_DOMAIN} www.invalid
	redir @www https://{$DOMAIN}{uri} permanent

	# === SECURITY HEADERS (every response: studio, warmth pages, API) ===
	# "?" = default only: pages that send their own stricter set (the
	# /read reader, /reset) keep theirs instead of getting two of each.
	# One directive per field: "?" fields in one block are only applied
	# when ALL of them are absent, so a page sending just one would lose
	# the rest.
	# https://caddyserver.com/docs/caddyfile/directives/header
	# MIME sniffing off: a stored export is never re-interpreted as HTML/JS.
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	# Clickjacking: only this origin may frame the studio (legacy
	# header + the CSP frame-ancestors directive below).
	header ?X-Frame-Options "SAMEORIGIN"
	# ENFORCED CONTENT-SECURITY-POLICY — the full allow-list, one field
	# (V approved enforcing it; README "Security headers" lists every
	# source and why). It was derived by clicking through every studio
	# feature in headless Chromium with a securitypolicyviolation
	# listener and the report endpoint below: first report-only, then
	# enforced, with zero violations. Each source and why it is needed:
	#  default-src 'self'      — everything not named below: own origin.
	#  script-src 'unsafe-inline' — the studio is ONE self-contained
	#      index.html whose code is inline <script> blocks (and the
	#      warmth/reset pages carry small inline scripts). Its libraries
	#      (JSZip, mammoth, lucide, jsPDF) are vendored under
	#      /assets/vendor/ with SRI, so NO third-party script host is
	#      allowed and 'unsafe-eval' is not granted.
	#  style-src 'unsafe-inline' — inline <style> blocks and style=""
	#      attributes throughout the studio markup.
	#  ==== BEUK:fonts ==== NO font host: every web font is self-hosted
	#      under /assets/fonts/ (client/assets/fonts/README.md), so
	#      style-src and font-src are 'self' (+ the data:/inline below)
	#      and Google's two font hosts (stylesheet + files) are named
	#      NOWHERE in this policy — a browser enforcing it cannot send a
	#      visitor's IP to Google for a font (LG München I, 20.01.2022,
	#      3 O 17493/20). tests/fonts-selfhosted.test.ts holds it there.
	#  font-src data: — writer-uploaded fonts are applied as
	#      FontFace('url(data:…)') and data-URI @font-face rules.
	#  img-src data: — book pictures, covers and canvases are data: URIs.
	#  https://images.pexels.com (img-src, connect-src) — signed-in
	#      cover/scene photo search goes through /api/stock (Pexels);
	#      every Pexels photo `src` URL is on images.pexels.com
	#      (https://www.pexels.com/api/documentation/ "The Photo
	#      Resource"); the grid shows them and the chosen one is
	#      fetch()ed into the book's own image library.
	#  https://api.openverse.org (img-src, connect-src) — photo search
	#      when no shelf answers (studio offline from its server): the
	#      browser queries Openverse directly and shows its thumbnails,
	#      served from /v1/images/{identifier}/thumb/ on the same host
	#      (https://api.openverse.org/v1/schema/). Openverse ORIGINALS
	#      live on each photographer's own host and are NOT allowed —
	#      see README for that trade-off.
	#  connect-src 'self' also covers the zen ambient recordings: the
	#      studio fetch()es /assets/sound/*.mp3 from its own origin and
	#      decodes them with Web Audio (fetch() is governed by connect-src:
	#      https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Content-Security-Policy/connect-src).
	#      file_server types them audio/mpeg (the caddy image's /etc/mime.types).
	#  worker-src 'self' — the service worker (/sw.js). PDF import
	#      (BEUK:pdfimport) needs nothing more: PDF.js is loaded from
	#      'self' as SRI-pinned module scripts (.mjs, typed text/javascript
	#      by file_server) and parses on the main thread — no worker, no eval.
	#  frame-src 'self' — the print-preview iframe (srcdoc) and help.
	#  frame-src blob:, media-src 'self' blob: — ==== BEUK:research ====
	#      a research file opens in the Notebook from an object URL the
	#      studio makes from the book's own bytes: a PDF in a frame, a
	#      recording or a clip in <audio>/<video> (media-src would
	#      otherwise fall back to default-src 'self'). Only those kinds
	#      are ever framed or played — the studio types each Blob from a
	#      fixed list, never HTML (rsKinds in client/index.html) — and
	#      research pictures stay data: URIs (img-src above).
	#  form-action / base-uri 'self', object-src 'none',
	#  frame-ancestors 'self' — no foreign form targets, no <base>
	#      hijack, no plugins, no framing by other sites.
	#  report-uri + report-to — violations POST to /api/csp-report
	#      (src/routes/csp-report.ts: rate-limited, 16 KiB cap, one
	#      PII-free log line each, nothing stored). report-uri is the
	#      deprecated form some browsers still use; browsers that
	#      support report-to ignore it:
	#      https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Content-Security-Policy/report-uri
	#      https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Content-Security-Policy/report-to
	# The /read reader sends its own stricter policy (the "?" prefix
	# leaves it alone); /reset and the warmth pages get this one.
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://images.pexels.com https://api.openverse.org; connect-src 'self' https://images.pexels.com https://api.openverse.org; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; frame-src 'self' blob:; form-action 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; report-uri /api/csp-report; report-to csp"
	# Reporting API endpoint for "report-to csp". A relative URL is
	# resolved against the response URL (https://w3c.github.io/reporting/
	# "process reporting endpoints": parsed "with base URL set to
	# response's url"); the endpoint must be potentially trustworthy, so
	# browsers only use it over HTTPS / localhost.
	header ?Reporting-Endpoints "csp=\"/api/csp-report\""
	# HSTS only over real TLS on a real domain. Browsers ignore it over
	# plain HTTP anyway (RFC 6797 §8.1: "If an HTTP response is received
	# over insecure transport, the UA MUST ignore any present STS header
	# field(s)" — https://www.rfc-editor.org/rfc/rfc6797#section-8.1),
	# and it is never sent for localhost / 127.0.0.1 so local mode
	# (http://localhost:8090, or https://localhost with Caddy's internal
	# CA) never pins a dev box to HTTPS. No includeSubDomains/preload:
	# other subdomains are not this deploy's to promise.
	# Matcher syntax: https://caddyserver.com/docs/caddyfile/matchers
	@hsts {
		protocol https
		not host localhost 127.0.0.1
	}
	header @hsts Strict-Transport-Security "max-age=31536000"

	# ==== BEUK:lanhttps ==== The local CA's root certificate, so a phone
	# or tablet can trust the https://<ip> addresses once (it is the
	# public half only; the key never leaves caddy_data). Served only
	# when start-local.ps1 sets BEUK_LOCAL_CA=1 — production never has it.
	@localca {
		path /beuk-local-ca.crt
		expression `{env.BEUK_LOCAL_CA} == "1"`
	}
	handle @localca {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type "application/x-x509-ca-cert"
		header Content-Disposition "attachment; filename=\"beuk-local-ca.crt\""
		header Cache-Control "no-store"
		file_server
	}

	# API → Node app
	handle /api/* {
		reverse_proxy app:3000
	}

	# Beuk School media (lesson video, audio and screenshots) straight
	# from disk, with range requests so video seeks work. Produced by
	# tools/school-media and copied to ./school-media on the box. The more
	# specific path sorts before /school* below.
	handle /school/media/* {
		uri strip_prefix /school/media
		root * /srv/school-media
		header Cache-Control "public, max-age=3600"
		file_server
	}
	# Beuk School pages (src/routes/school.ts), server-rendered by the app.
	handle /school* {
		reverse_proxy app:3000
	}

	# M4 warmth pages → Node app (their support block and tip-jar slots
	# depend on server config: SUPPORT_EMAIL / KOFI_URL). The app reads
	# the page files from the same ./client tree mounted below.
	handle /help* {
		reverse_proxy app:3000
	}
	handle /thanks* {
		reverse_proxy app:3000
	}
	handle /support* {
		reverse_proxy app:3000
	}
	handle /changelog {
		reverse_proxy app:3000
	}
	handle /roadmap {
		reverse_proxy app:3000
	}
	# The legal pages (src/legal/render.ts): their operator details
	# come from the LEGAL_* settings in .env.
	handle /privacy* {
		reverse_proxy app:3000
	}
	handle /terms* {
		reverse_proxy app:3000
	}
	# P0 #5: the "choose a new password" page reset emails link to
	# (/reset?token=…). Served by the app; never cached.
	handle /reset* {
		reverse_proxy app:3000
	}
	# The account page ("your typesetting portal"), the email-confirmation
	# page its links open (/account/confirm?token=…), and its CSS + script.
	handle /account* {
		reverse_proxy app:3000
	}
	# Beta-reader share links: the server-rendered read-only reader
	# (/read/<token>), its pictures and its comment API.
	handle /read* {
		reverse_proxy app:3000
	}
	handle /robots.txt {
		reverse_proxy app:3000
	}
	handle /sitemap.xml {
		reverse_proxy app:3000
	}
	# The public status page (server-rendered; /api/status/public is its JSON).
	handle /status* {
		reverse_proxy app:3000
	}
	# The landing page is the site's front door; the studio lives at /studio
	# (and still at /index.html, which its offline shell caches). Every other
	# path keeps falling back to the studio, so old links still open it.
	@landing path /
	handle @landing {
		header Cache-Control "no-cache"
		header X-Beuk-Page "landing"
		root * /srv/client
		rewrite * /site/index.html
		file_server
	}
	redir /studio/ /studio 308
	handle /studio {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /index.html
		file_server
	}

	# The site pages beside the landing page (client/site/): /features and
	# the comparisons, /compare and /compare/<name>. Exact paths only; a
	# trailing slash redirects to the bare path. Any other /compare/... path
	# falls through to the studio like every unknown path.
	redir /features/ /features 308
	handle /features {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/features.html
		file_server
	}
	# Ramp: books set and printed by Beuk (client/site/ramp.html).
	redir /ramp/ /ramp 308
	handle /ramp {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/ramp.html
		file_server
	}
	redir /compare/ /compare 308
	handle /compare {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/index.html
		file_server
	}
	redir /compare/atticus/ /compare/atticus 308
	handle /compare/atticus {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/atticus.html
		file_server
	}
	redir /compare/vellum/ /compare/vellum 308
	handle /compare/vellum {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/vellum.html
		file_server
	}
	redir /compare/reedsy-studio/ /compare/reedsy-studio 308
	handle /compare/reedsy-studio {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/reedsy-studio.html
		file_server
	}
	redir /compare/dabble/ /compare/dabble 308
	handle /compare/dabble {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/dabble.html
		file_server
	}
	redir /compare/scrivener/ /compare/scrivener 308
	handle /compare/scrivener {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/scrivener.html
		file_server
	}
	redir /compare/novelcrafter/ /compare/novelcrafter 308
	handle /compare/novelcrafter {
		header Cache-Control "no-cache"
		root * /srv/client
		rewrite * /site/compare/novelcrafter.html
		file_server
	}

	# === STATIC CLIENT ===
	# The built Beuk web client lives in ./client (mounted at /srv/client).
	# SPA fallback: unknown paths return index.html.
	handle {
		# Revalidate on every load (cheap 304 via ETag) so a deploy reaches
		# writers immediately instead of a heuristically cached old studio.
		header Cache-Control "no-cache"
		root * /srv/client
		try_files {path} /index.html
		file_server
	}
}
