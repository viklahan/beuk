{
  "name": "beuk-studio-next",
  "private": true,
  "version": "0.0.0",
  "description": "Beuk 2.0 studio (React), served at /next. Builds to ../client/next.",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "extract": "node scripts/extract-studio.mjs",
    "typecheck": "node scripts/extract-studio.mjs && tsc --noEmit -p tsconfig.json",
    "build": "node scripts/extract-studio.mjs && tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "e2e": "node e2e/shell.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "y-indexeddb": "9.0.12",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "overrides": {
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "prosemirror-transform": "1.12.2",
    "yjs": "13.6.33",
    "prosemirror-changeset": "2.4.4",
    "prosemirror-schema-list": "1.5.1"
  }
}
