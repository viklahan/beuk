# Copy to .env and fill in. NEVER commit a real .env.
# All values below are placeholders for local development only.

# Public site address Caddy serves. Use "localhost" for local dev
# (Caddy issues an internal-CA certificate); use beuk.studio in production
# (Caddy obtains a real Let's Encrypt certificate automatically).
DOMAIN=localhost
# Optional second host (e.g. www.beuk.studio) that Caddy serves and
# permanently redirects to DOMAIN. Empty = none. It needs its own DNS
# record. deploy/install.sh sets it to www.<domain> (DEPLOY_WWW=0: empty).
WWW_DOMAIN=

# Compose project name. deploy/install.sh writes it (default "beuk") so a
# bare `docker compose …` in this directory reaches the same containers
# and volumes; without it Compose uses the directory name instead.
# COMPOSE_PROJECT_NAME=beuk

# Postgres (used by the db service; the app builds its DATABASE_URL from these)
POSTGRES_USER=beuk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=beuk

# App
# Full override if you run the app outside Compose; leave unset in Compose.
# DATABASE_URL=postgres://beuk:change-me-local-only@localhost:5432/beuk
PORT=3000
APP_TIMEZONE=UTC
# Set to "true" in production (HTTPS) so session cookies are Secure.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# M2 — export archive
# Directory the app stores export bytes under (per-user subdirectories).
# In Compose this is the exportdata volume at /data/exports; only set it
# when running the app outside Compose.
# EXPORT_DIR=/data/exports
EXPORT_MAX_BYTES=52428800
# Largest book (JSON, pictures and snapshots included) the shelf accepts.
# MANUSCRIPT_MAX_BYTES=67108864
# Restore from a backup (Housekeeping POST /api/housekeeping/restore).
# On by default: a backup carries every data table, share links, reader
# comments, reader records and jobs included. Set false to turn restore
# off (the endpoint then answers 503 with the reason).
# RESTORE_ENABLED=true

# Billing (Stripe). Leave ALL of these unset until pricing is decided:
# while unset, /api/billing/checkout and /api/billing/webhook answer 501
# "billing not configured" and nothing can be granted. To enable later:
#   1. In Stripe, create the product(s) + recurring price(s). Write
#      ENTITLEMENTS_FILE (JSON, see README "Billing") mapping each price id
#      to the entitlements it carries; put the default price id (price_…)
#      in STRIPE_PRICE_ID.
#   2. Put the API secret key in STRIPE_SECRET_KEY (sk_test_… / rk_test_…
#      for test mode, sk_live_… / rk_live_… for live). The server reads
#      its mode from this prefix and applies only events of that mode.
#   3. Register the webhook endpoint https://beuk.studio/api/billing/webhook
#      for the event types listed in README "Billing"; put its signing
#      secret (whsec_…) in STRIPE_WEBHOOK_SECRET. Test and live endpoints
#      have DIFFERENT secrets.
#   4. Set APP_BASE_URL to the public site origin (checkout redirects).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional cross-check: test | live. If set and the key's prefix says
# otherwise, billing refuses to run.
# STRIPE_MODE=
# Path to the entitlements JSON (price id -> entitlements). Unset = no
# price grants anything and no feature is gated.
# ENTITLEMENTS_FILE=/app/config/entitlements.json
# Days a past_due subscription keeps its entitlements (default 7).
# BILLING_GRACE_DAYS=7
APP_BASE_URL=https://localhost

# M3 — Housekeeping (admin surface at /api/housekeeping/*, 404 to
# everyone who is not a signed-in admin).
# Admin is NOT configured here: register your account in the app, then
# on the server run
#   docker compose exec app node dist/admin-cli.js grant you@example.com
# (also: revoke <email>, list). Nothing over HTTP can grant admin.
# Directory named backups are written under. In Compose this is the
# backupdata volume at /data/backups; only set it outside Compose.
# BACKUP_DIR=/data/backups
# Stamp identifying this build (or set GIT_SHA). Self-checks runs and
# promotion sign-offs are recorded against it; promotion requires a
# passing run + a sign-off on THIS stamp. Unset → a per-boot dev stamp.
BUILD_STAMP=
GIT_SHA=
# The promotion gate refuses unless the working tree is marked clean:
# set TREE_CLEAN=true in the deploy, or point TREE_CLEAN_FILE at a
# marker file the deploy creates (default: ./.tree-clean).
TREE_CLEAN=
# TREE_CLEAN_FILE=/app/.tree-clean
# Where a successful promotion writes PROMOTION_MANIFEST.json.
# PROMOTION_MANIFEST_PATH=/app/PROMOTION_MANIFEST.json

# M4 — Warmth Phase 0 (public surfaces: help reading room, status
# line, Founders' Shelf).
# The support address shown on the Help pages. Email is the official
# support channel. Leave it EMPTY until the mailbox really exists: while
# it is empty, no page shows an address, a name or a reply promise —
# the Help pages' "When the guides run out" block, the footer address,
# the /support page's write-in line and the "write to …" hints are all
# absent, and /api/config/public answers support.email = null.
SUPPORT_EMAIL=
# Only used when SUPPORT_EMAIL is set, and each only when set itself (no
# built-in defaults): the named human ("write to <name> at …") and the
# reply-time promise ("The promise: <promise>."), e.g.
#   SUPPORT_NAME=Vik
#   SUPPORT_REPLY_PROMISE=a human replies within two working days
SUPPORT_NAME=
SUPPORT_REPLY_PROMISE=
# Ko-fi page URL for the tip jar, e.g. https://ko-fi.com/yourname.
# The jar is framed as "support the maker" and appears ONLY at the foot
# of the Help pages and on the post-export thanks page. Leave EMPTY to
# show no jar anywhere — there is no placeholder while unset.
KOFI_URL=
# Legal pages (/privacy and /terms, text in content/legal/). Who runs
# the service and how to reach them. Leave a value EMPTY until it is
# real: while it is empty the page shows a visible "this part is being
# completed" notice in its place, and a box at the top lists every
# missing detail — no name, address or jurisdiction is ever invented.
#   LEGAL_OPERATOR_NAME     the person or company running this server
#                           (the data controller), e.g. a full legal name
#   LEGAL_CONTACT_EMAIL     where privacy / legal requests go; empty =
#                           SUPPORT_EMAIL is used (both empty = notice)
#   LEGAL_POSTAL_ADDRESS    a postal address for the operator
#   LEGAL_JURISDICTION      the governing law, as it should read after
#                           "governed by the law of", e.g. England and Wales
#   LEGAL_HOSTING_LOCATION  where the server is, e.g. Germany (Hetzner)
#   LEGAL_EFFECTIVE_DATE    YYYY-MM-DD the current text takes effect;
#                           empty = the pages show the date in the
#                           content file's "updated:" line
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_POSTAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_HOSTING_LOCATION=
LEGAL_EFFECTIVE_DATE=
# Version string reported by GET /api/status. Defaults to the package
# version; set per deploy if you version differently.
APP_VERSION=

# M5 — server jobs (EPUBCheck + PDF/X, run over the export archive;
# see the README "Jobs" section). Leave EPUBCHECK_JAR and GS_BIN
# EMPTY until the tools are installed on the server: jobs are still
# accepted, run, and complete as FAILED with "not configured" stated
# in their result — a result is never fabricated. To enable:
#   1. Install a JRE (e.g. default-jre-headless) and Ghostscript.
#   2. Download the EPUBCheck release from github.com/w3c/epubcheck,
#      unpack it, and set EPUBCHECK_JAR to its epubcheck.jar path.
#   3. Set GS_BIN to the Ghostscript binary (e.g. /usr/bin/gs).
#   4. The CMYK press profile tools/PDFX_def.ps embeds
#      (/usr/share/color/icc/beuk/SWOP2006_Coated3v2.icc, CGATS TR 003)
#      is installed by deploy/Dockerfile.tools (pinned URL + sha256).
#      Outside that image, put the same file at that path — see README
#      "Jobs", production step 5.
EPUBCHECK_JAR=
JAVA_BIN=java
GS_BIN=
# The PDF/X definition file handed to Ghostscript (default:
# tools/PDFX_def.ps under the app directory).
# PDFX_DEF=/app/tools/PDFX_def.ps
# Ghostscript ICC directory whose default_cmyk.icc is the press profile
# (pdfwrite converts into it and ignores -sOutputICCProfile). Built by
# deploy/Dockerfile.tools and set by deploy/docker-compose.tools.yml;
# unset, conversions use Ghostscript's built-in CMYK profile and the
# housekeeping check jobs.pdfx.converts-through-press-profile fails.
# PDFX_ICC_DIR=/usr/share/color/icc/beuk/gs/
# Resolution of the CMYK raster the pdfx job renders from its own
# output to measure total ink (default 100).
# PDFX_INK_DPI=100
# Wall-clock timeout in milliseconds for EPUBCheck and for the pdfx
# job's HTML-to-PDF renderer request (default 120000).
JOB_TIMEOUT_MS=120000
# Wall-clock timeout in milliseconds for the pdfx job's Ghostscript
# step (default 900000 = 15 min). PDF/X-1a forbids transparency, so
# Ghostscript flattens any page that has some to an image (408 s for
# the sample before the print interior dropped its transparency; the
# whole job now takes ~65 s). 15 min is an operational default, not a
# measurement.
# PDFX_TIMEOUT_MS=900000
# EPUBCheck JVM heap cap, passed as -Xmx (default 512m; <digits>[k|m|g]).
# JAVA_MAX_HEAP=512m
# Job admission caps: jobs one user may have queued/running at once
# (next create → 429), and jobs the whole server holds (next → 503).
# JOB_MAX_ACTIVE_PER_USER=2
# JOB_MAX_QUEUED=20
# PDF/X rendition runs in the isolated "renderer" service the tools
# overlay adds (deploy/renderer/); the overlay sets RENDERER_URL for the
# app. Its hard per-render timeout in ms (default 90000):
# RENDER_TIMEOUT_MS=90000
# HTML_PDF_BIN is retired (Chromium inside the app container could read
# the app's secrets and volumes) and is ignored if set.

# Stock photos (cover-maker backgrounds, via Pexels). Leave
# PEXELS_API_KEY EMPTY until you create a (free) Pexels API key at
# pexels.com: while unset, GET /api/stock/search answers 501 "stock
# photos not configured" and the cover maker simply offers no stock
# search. The key is used server-side only — it is sent to Pexels as
# the Authorization header and never reaches clients.
PEXELS_API_KEY=
# Override the Pexels API base URL (tests point this at a stub).
# PEXELS_API_BASE=https://api.pexels.com/v1

# Hardening. Reverse-proxy hops in front of the app (Caddy = 1). Set 0
# if the app is ever reached directly, or clients can spoof their IP.
# TRUST_PROXY_HOPS=1
# Per-client-IP rate limit on login and on register (separate buckets):
# AUTH_RATE_BURST attempts, then one more every AUTH_RATE_REFILL_MS.
# AUTH_RATE_BURST=10
# AUTH_RATE_REFILL_MS=60000
# On SIGTERM: grace for in-flight requests + a running job (keep it
# below compose's stop_grace_period of 30s).
# SHUTDOWN_GRACE_MS=20000
# How often expired sessions are deleted (also once at boot).
# SESSION_PURGE_INTERVAL_MS=3600000
# Account basics — outgoing email for password-reset links. Leave
# SMTP_URL and MAIL_FROM EMPTY until you have an SMTP provider: while
# either is unset NO email is sent and none is ever reported as sent
# (Housekeeping shows "email not configured"; the studio tells the
# writer no message will arrive).
#   SMTP_URL   nodemailer connection URL, e.g.
#              smtp://user:pass@smtp.example.com:587   (STARTTLS when offered)
#              smtps://user:pass@smtp.example.com:465  (implicit TLS)
#              URL-encode special characters in the password.
#   MAIL_FROM  the From address, e.g. Beuk <no-reply@beuk.studio>
# After setting them, run Housekeeping's POST /api/housekeeping/mail/test.
SMTP_URL=
MAIL_FROM=
# When email is NOT configured, write the would-be message (reset link
# included) to the app log. Default: on unless NODE_ENV=production —
# the Docker image runs production, so set true for a LOCAL stack only.
# Never enable on a public server: the link is a live credential.
MAIL_LOG_LINKS=

# Backups. Scheduled local backups (Housekeeping, under BACKUP_DIR):
# one every BACKUP_INTERVAL_HOURS (default 24; 0 turns the schedule
# off). Local backups are NEVER deleted automatically: watch the
# backupdata volume's disk use until a local retention rule is decided.
# BACKUP_INTERVAL_HOURS=24
#
# Off-site backups: restic copies each scheduled backup to a PRIVATE
# Backblaze B2 bucket through B2's S3-compatible API, encrypted before
# it leaves the box. Leave all five EMPTY until set up (Housekeeping
# then says "not configured"; nothing is ever reported as backed up).
# Setup steps: README "Off-site backups".
#   OFFSITE_B2_KEY_ID           the application key's keyID
#   OFFSITE_B2_APPLICATION_KEY  the applicationKey (shown once by B2)
#   OFFSITE_B2_BUCKET           the bucket name
#   OFFSITE_B2_ENDPOINT         the bucket's S3 endpoint, e.g.
#                               https://s3.us-west-004.backblazeb2.com
#   RESTIC_PASSWORD             the repository password. It is the ONLY
#                               key to every off-site backup: keep it in
#                               a password manager AND on paper. Lose it
#                               and the off-site backups are unreadable.
OFFSITE_B2_KEY_ID=
OFFSITE_B2_APPLICATION_KEY=
OFFSITE_B2_BUCKET=
OFFSITE_B2_ENDPOINT=
RESTIC_PASSWORD=
# Folder inside the bucket (default beuk).
# OFFSITE_B2_PREFIX=beuk
# Retention (restic forget --prune): daily / weekly / monthly snapshots kept.
# RESTIC_KEEP_DAILY=7
# RESTIC_KEEP_WEEKLY=4
# RESTIC_KEEP_MONTHLY=12
# The self-check backup.offsite.fresh fails when the last successful
# off-site backup is older than this many hours, or the last run failed.
# OFFSITE_MAX_AGE_HOURS=36
# Restore drill: restore the latest snapshot to a scratch dir and check
# it against its manifest every N hours (default 168 = weekly; 0 = off);
# backup.offsite.drill fails when the last drill failed or is older
# than OFFSITE_DRILL_MAX_AGE_HOURS (default 192).
# OFFSITE_DRILL_INTERVAL_HOURS=168
# OFFSITE_DRILL_MAX_AGE_HOURS=192
# restic retries a wrong key or a missing bucket for minutes instead of
# exiting, so the first repository probe of each run is cut off after
# OFFSITE_PROBE_TIMEOUT_MS (default 120000) and reported with the error
# restic kept retrying on. Every other restic step: RESTIC_TIMEOUT_MS
# (default 1800000 = 30 min).
# OFFSITE_PROBE_TIMEOUT_MS=120000
# RESTIC_TIMEOUT_MS=1800000

# Local backup retention. Leave BOTH empty to keep every local backup
# (the default: nothing is deleted). Set one or both to prune older local
# backups after each scheduler tick: BACKUP_KEEP_COUNT=n keeps the n
# newest, BACKUP_KEEP_DAYS=d keeps everything younger than d days (both
# set: a backup is kept if either rule keeps it). The newest complete
# backup is never deleted, and nothing is deleted while a backup runs.
BACKUP_KEEP_DAYS=
BACKUP_KEEP_COUNT=
# Backup alerts: one message when a backup self-check turns red, one when
# all are green again (checked every 15 minutes; never one per tick).
#   ALERT_EMAIL          your address; used only when SMTP_URL + MAIL_FROM
#                        are set (otherwise Housekeeping says email isn't
#                        set up and nothing is claimed as sent)
#   ALERT_WEBHOOK_URL    an incoming-webhook URL (Slack, Discord, or any
#                        endpoint taking a JSON POST). It is a credential:
#                        never shown, scrubbed from every output.
#   ALERT_WEBHOOK_FORMAT json (default: the full alert object, with "text"
#                        and "content" lines), slack ({"text"}) or
#                        discord ({"content"})
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_FORMAT=json
# Studio error reports are kept this many days (default 30). The studio
# only says "kept for a limited time"; if the privacy page names a number,
# keep it in step with this setting.
# CLIENT_ERRORS_KEEP_DAYS=30
