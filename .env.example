# Copy to .env and fill in. NEVER commit a real .env.
# All values below are placeholders for local development only.

# Public site address Caddy serves. Use "localhost" for local dev
# (Caddy issues an internal-CA certificate); use beuk.studio in production
# (Caddy obtains a real Let's Encrypt certificate automatically).
DOMAIN=localhost

# Postgres (used by the db service; the app builds its DATABASE_URL from these)
POSTGRES_USER=beuk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=beuk

# App
# Full override if you run the app outside Compose; leave unset in Compose.
# DATABASE_URL=postgres://beuk:change-me-local-only@localhost:5432/beuk
PORT=3000
APP_TIMEZONE=UTC
# Set to "true" in production (HTTPS) so session cookies are Secure.
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# M2 — export archive
# Directory the app stores export bytes under (per-user subdirectories).
# In Compose this is the exportdata volume at /data/exports; only set it
# when running the app outside Compose.
# EXPORT_DIR=/data/exports
EXPORT_MAX_BYTES=52428800

# M2 — billing hooks (Stripe). Leave ALL of these unset until you set a
# price: while unset, /api/billing/* answers 501 "billing not configured"
# and no plan can change. To enable billing later:
#   1. Create the Pro product + recurring price in Stripe; put its price
#      id (price_…) in STRIPE_PRICE_ID.
#   2. Put the API secret key (sk_…) in STRIPE_SECRET_KEY.
#   3. Register the webhook endpoint https://beuk.studio/api/billing/webhook
#      for checkout.session.completed, customer.subscription.updated and
#      customer.subscription.deleted; put its signing secret (whsec_…) in
#      STRIPE_WEBHOOK_SECRET. Plans change ONLY from signature-verified
#      webhook events.
#   4. Set APP_BASE_URL to the public site origin (checkout redirects).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
APP_BASE_URL=https://localhost

# M3 — Housekeeping (admin surface at /api/housekeeping/*, 404 to
# everyone who is not a signed-in admin).
# Admin is NOT configured here: register your account in the app, then
# on the server run
#   docker compose exec app node dist/admin-cli.js grant you@example.com
# (also: revoke <email>, list). Nothing over HTTP can grant admin.
# Directory named backups are written under. In Compose this is the
# backupdata volume at /data/backups; only set it outside Compose.
# BACKUP_DIR=/data/backups
# Stamp identifying this build (or set GIT_SHA). Self-checks runs and
# promotion sign-offs are recorded against it; promotion requires a
# passing run + a sign-off on THIS stamp. Unset → a per-boot dev stamp.
BUILD_STAMP=
GIT_SHA=
# The promotion gate refuses unless the working tree is marked clean:
# set TREE_CLEAN=true in the deploy, or point TREE_CLEAN_FILE at a
# marker file the deploy creates (default: ./.tree-clean).
TREE_CLEAN=
# TREE_CLEAN_FILE=/app/.tree-clean
# Where a successful promotion writes PROMOTION_MANIFEST.json.
# PROMOTION_MANIFEST_PATH=/app/PROMOTION_MANIFEST.json

# M4 — Warmth Phase 0 (public surfaces: help reading room, status
# line, Founders' Shelf).
# The support address shown on the Help page. Email is the official
# support channel — PLACEHOLDER: set the real address writers should
# write to before launch.
SUPPORT_EMAIL=support@beuk.studio
# The named human on the Help page, and the reply-time promise wording
# shown next to the address. Defaults: "the maker of Beuk" and
# "a human replies within two working days".
SUPPORT_NAME=
SUPPORT_REPLY_PROMISE=
# Ko-fi page URL for the tip jar, e.g. https://ko-fi.com/yourname.
# The jar is framed as "support the maker" and appears ONLY at the foot
# of the Help pages and on the post-export thanks page. Leave EMPTY to
# show no jar anywhere — there is no placeholder while unset.
KOFI_URL=
# Version string reported by GET /api/status. Defaults to the package
# version; set per deploy if you version differently.
APP_VERSION=

# M5 — server jobs (EPUBCheck + PDF/X, run over the export archive;
# see the README "Jobs" section). Leave EPUBCHECK_JAR and GS_BIN
# EMPTY until the tools are installed on the server: jobs are still
# accepted, run, and complete as FAILED with "not configured" stated
# in their result — a result is never fabricated. To enable:
#   1. Install a JRE (e.g. default-jre-headless) and Ghostscript.
#   2. Download the EPUBCheck release from github.com/w3c/epubcheck,
#      unpack it, and set EPUBCHECK_JAR to its epubcheck.jar path.
#   3. Set GS_BIN to the Ghostscript binary (e.g. /usr/bin/gs).
#   4. Edit tools/PDFX_def.ps: point its ICC profile path at a real
#      CMYK press profile installed on the server (e.g. one from the
#      icc-profiles-free package) — PDF/X-1a needs a real profile.
EPUBCHECK_JAR=
JAVA_BIN=java
GS_BIN=
# The PDF/X definition file handed to Ghostscript (default:
# tools/PDFX_def.ps under the app directory).
# PDFX_DEF=/app/tools/PDFX_def.ps
# Per-job wall-clock timeout in milliseconds (default 120000).
JOB_TIMEOUT_MS=120000
# EPUBCheck JVM heap cap, passed as -Xmx (default 512m; <digits>[k|m|g]).
# JAVA_MAX_HEAP=512m
# Job admission caps: jobs one user may have queued/running at once
# (next create → 429), and jobs the whole server holds (next → 503).
# JOB_MAX_ACTIVE_PER_USER=2
# JOB_MAX_QUEUED=20
# PDF/X rendition runs in the isolated "renderer" service the tools
# overlay adds (deploy/renderer/); the overlay sets RENDERER_URL for the
# app. Its hard per-render timeout in ms (default 90000):
# RENDER_TIMEOUT_MS=90000
# HTML_PDF_BIN is retired (Chromium inside the app container could read
# the app's secrets and volumes) and is ignored if set.

# Stock photos (cover-maker backgrounds, via Pexels). Leave
# PEXELS_API_KEY EMPTY until you create a (free) Pexels API key at
# pexels.com: while unset, GET /api/stock/search answers 501 "stock
# photos not configured" and the cover maker simply offers no stock
# search. The key is used server-side only — it is sent to Pexels as
# the Authorization header and never reaches clients.
PEXELS_API_KEY=
# Override the Pexels API base URL (tests point this at a stub).
# PEXELS_API_BASE=https://api.pexels.com/v1

# Hardening. Reverse-proxy hops in front of the app (Caddy = 1). Set 0
# if the app is ever reached directly, or clients can spoof their IP.
# TRUST_PROXY_HOPS=1
# Per-client-IP rate limit on login and on register (separate buckets):
# AUTH_RATE_BURST attempts, then one more every AUTH_RATE_REFILL_MS.
# AUTH_RATE_BURST=10
# AUTH_RATE_REFILL_MS=60000
# On SIGTERM: grace for in-flight requests + a running job (keep it
# below compose's stop_grace_period of 30s).
# SHUTDOWN_GRACE_MS=20000
# How often expired sessions are deleted (also once at boot).
# SESSION_PURGE_INTERVAL_MS=3600000
