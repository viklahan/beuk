# Simulation stack ONLY (compose project "beuk-sim", http://localhost:8190).
# Passed with --env-file by tools/sim/sim.mjs; never read by start-local.ps1
# or deploy/install.sh. Every value here is a disposable local value.
DOMAIN=http://localhost:8190
WWW_DOMAIN=
POSTGRES_USER=beuk
POSTGRES_PASSWORD=sim-only-disposable
POSTGRES_DB=beuk
APP_BASE_URL=http://localhost:8190
COOKIE_SECURE=false
APP_TIMEZONE=UTC
# The simulation registers and signs in ~20 times from one address in a
# few seconds; the production default (10, then one a minute) would
# throttle it. This is the existing AUTH_RATE_BURST knob (src/config.ts),
# not a new flag; production keeps its own .env value.
AUTH_RATE_BURST=100000
AUTH_RATE_REFILL_MS=1000
# Billing stays unset: src/access.ts then answers "open" and nothing is
# gated, so the trial never pauses a simulated writer.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# No scheduled backups inside the disposable stack.
BACKUP_INTERVAL_HOURS=0
MAIL_LOG_LINKS=
