%!PS-Adobe-3.0
%% Beuk — PDF/X-1a definition file for Ghostscript.
%%
%% The pdfx job feeds this file to Ghostscript BEFORE the input
%% (see ghostscriptPdfxArgs in src/jobs/tools.ts, and the Jobs
%% section of the README). It declares the PDF/X-1a OutputIntent
%% and embeds the CMYK ICC profile the intent points at.
%%
%% THE PROFILE (why this one — evidence, not taste):
%%  - IngramSpark's File Creation Guide (downloaded 2026-10-24,
%%    https://www.ingramspark.com/hubfs/downloads/file-creation-guide.pdf)
%%    requires "PDF/X-1a:2001 or PDF/X-3:2002", CMYK images, total ink
%%    at most 240%, and names NO characterisation or press profile.
%%    KDP's cover/paperback help (https://kdp.amazon.com/help/topic/G201953020,
%%    https://kdp.amazon.com/help/topic/G201857950) asks for CMYK and
%%    names no profile either. So neither printer states a condition.
%%  - The only named profile found is second-hand: an Adobe forum post
%%    quoting IngramSpark's FAQ — "we recommend the U.S. Web Coated
%%    (SWOP) v2" — i.e. US SWOP coated web offset (unverified on
%%    ingramspark.com; https://community.adobe.com/t5/acrobat-discussions/creating-ingramspark-compatible-pdf-x-with-acrobat-pro/m-p/8084560).
%%    Adobe's SWOP v2 profile may NOT be bundled with software
%%    ("distribute the Software only (a) as embedded within digital
%%    image files and (b) on a standalone basis",
%%    https://support.epson.net/terms/lfp/1260_pl/eula/index.php), so it
%%    cannot ship in this image.
%%  - The redistributable US-SWOP profile is IDEAlliance's
%%    SWOP2006_Coated3v2.icc in the ICC Profile Registry
%%    (https://registry.color.org/profile-registry/SWOP2006_Coated3v2):
%%    characterisation "CGATS TR003", ISO 12647-2:2004, web offset,
%%    TAC 300%, medium GCR; licence "may be used, embedded, exchanged,
%%    and shared without restriction. It may not be altered, or sold
%%    without written permission of IDEAlliance." (also in the
%%    profile's own cprt tag; see tools/icc/LICENSE-SWOP2006_Coated3v2.txt).
%%    Its registered characterisation, CGATS TR 003, is "SWOP proofing
%%    and printing on U.S. Grade 3 coated publication paper"
%%    (https://registry.color.org/cmyk-registry/cgats_tr_003).
%%  - KNOWN GAP: the profile's TAC is 300%; IngramSpark asks for <= 240%.
%%    Converting through this profile does not cap ink at 240%.
%%
%% deploy/Dockerfile.tools downloads that exact file (pinned URL +
%% sha256) to the path below. The housekeeping check
%% jobs.pdfx.icc-profile-matches-def verifies file, hash and these
%% strings agree. If the file does not exist, the job fails as
%% "not configured" — by design, never a fake pass.

/BeukICCPath (/usr/share/color/icc/beuk/SWOP2006_Coated3v2.icc) def

% PDF/X version key + document info (title/trailer are per-book at
% the PDF level; this declares the conformance claim).
[
  /GTS_PDFXVersion (PDF/X-1:2001)
  % PDF/X-1a:2001 is identified by the Conformance key alongside the
  % Version key (PRONOM fmt/157 signature: /GTS_PDFXConformance(PDF/X-1a:2001),
  % https://pronom.nationalarchives.gov.uk/fmt/157). Without it the
  % file only claims PDF/X-1:2001, which IngramSpark does not list.
  /GTS_PDFXConformance (PDF/X-1a:2001)
  /Trapped /False
  /DOCINFO pdfmark

% Embed the ICC profile as a stream object Ghostscript can reference.
[/_objdef {beukICCProfile} /type /stream /OBJ pdfmark
[{beukICCProfile} << /N 4 >> /PUT pdfmark
[{beukICCProfile} BeukICCPath (r) file /PUT pdfmark

% The OutputIntent dictionary. OutputConditionIdentifier is the ICC
% characterisation-registry reference name of the condition the
% embedded profile was built from ("CGATS TR 003",
% https://registry.color.org/cmyk-registry/cgats_tr_003); RegistryName
% is that registry; Info names the profile and the condition in words.
[/_objdef {beukOutputIntent} /type /dict /OBJ pdfmark
[{beukOutputIntent} <<
    /Type /OutputIntent
    /S /GTS_PDFX
    /OutputConditionIdentifier (CGATS TR 003)
    /RegistryName (http://www.color.org)
    /Info (SWOP2006_Coated3v2.icc - SWOP proofing and printing on U.S. Grade 3 coated publication paper \(CGATS TR 003\))
    /DestOutputProfile {beukICCProfile}
  >> /PUT pdfmark

% Attach the OutputIntent to the document catalog.
[{Catalog} << /OutputIntents [{beukOutputIntent}] >> /PUT pdfmark
